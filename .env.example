# ============================================================================
# VITA BI — Environment Variables
# Copie para .env e preencha os valores reais. NUNCA commite o .env.
# Em produção, injete via secrets do Antigravity.
# ============================================================================

# --- App ---
APP_NAME="Vita BI"
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql://vitabi:changeme@localhost:5432/vitabi
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=900

# --- Security ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=CHANGE_ME_BEFORE_DEPLOY
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- QuickBooks OAuth2 ---
# Obtenha em https://developer.intuit.com → seu app → Keys & credentials
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REFRESH_TOKEN=
QB_REALM_ID=
QB_ENVIRONMENT=production         # sandbox | production
QB_BASE_URL=https://quickbooks.api.intuit.com

# --- ETL paths ---
DE_PARA_DIR=/app/data/de_para
RAW_DIR=/app/data/raw
PROCESSED_DIR=/app/data/processed

# --- Insights thresholds (tunning) ---
CHURN_SIGMA_THRESHOLD=1.5
PRICE_ANOMALY_SIGMA=2.0
SLOW_MOVER_DAYS_COVER=180

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
